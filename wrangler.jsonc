// Cloudflare Workers config: serves the static site built into `out/` by `npm run build`.
{
  "name": "markhor-extreme",
  "compatibility_date": "2025-06-01",
  "routes": [
    { "pattern": "markhorextreme.com", "custom_domain": true },
    { "pattern": "www.markhorextreme.com", "custom_domain": true }
  ],
  "assets": {
    "directory": "./out",
    "not_found_handling": "404-page"
  }
}
